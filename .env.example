# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Huggingface configuration
VITE_HF_API_KEY=your_huggingface_api_key
VITE_HF_CHAT_MODEL=microsoft/DialoGPT-medium
VITE_HF_TITLE_MODEL=facebook/bart-large-cnn

# W3UP (Web3.Storage) Configuration
VITE_W3UP_EMAIL=your_w3up_account_email
VITE_W3UP_SPACE_DID=your_w3up_space_did

# Blockchain Configuration (Polygon Mumbai Testnet)
VITE_BLOCKCHAIN_RPC_URL=https://rpc-mumbai.maticvigil.com
VITE_CONTRACT_ADDRESS=your_deployed_contract_address
VITE_PRIVATE_KEY=your_wallet_private_key

# Algorand Configuration
VITE_ALGORAND_RPC_URL=https://testnet-api.4160.nodely.dev
VITE_ALGORAND_API_TOKEN=your_algorand_api_token
VITE_ALGORAND_MNEMONIC=your_25_word_algorand_mnemonic_phrase_here_with_spaces_between_each_word_exactly_twenty_five_words_total

# Pinata IPFS Configuration (for Edge Functions)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# Encryption Configuration - MUST match the ENCRYPTION_KEY in Supabase Edge Function
VITE_ENCRYPTION_KEY=chainspeak-secure-32-char-key-2024

# Edge Function Environment Variables (set these in Supabase Dashboard)
# ALGORAND_MNEMONIC=your_25_word_algorand_mnemonic_phrase_here_with_spaces_between_each_word_exactly_twenty_five_words_total
# ALGORAND_RPC_URL=https://testnet-api.4160.nodely.dev
# ENCRYPTION_KEY=chainspeak-secure-32-char-key-2024
